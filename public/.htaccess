# ==============================================================================
# ADEGA CONTAINER - CONFIGURAÇÃO APACHE / HOSTGATOR (.htaccess)
# ==============================================================================

# 1. FORÇAR HTTPS E CANONICAL WWW (https://www.adegacontainer.com.br)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Força www.adegacontainer.com.br se acessado sem www
  RewriteCond %{HTTP_HOST} ^adegacontainer\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.adegacontainer.com.br/$1 [L,R=301]
</IfModule>

# 2. TIPOS MIME CORRETOS (Garante que CSS, JS e Vídeos rodem no Apache)
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# 3. COMPACTAÇÃO GZIP (Desempenho e velocidade de carregamento)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. CACHE DE NAVEGADOR (Expiração de Estáticos)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 hour"

  # CSS e JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imagens e Mídia
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fontes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 5. CABEÇALHOS DE SEGURANÇA
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. PÁGINA DE ERRO (fallback para index.html se não encontrado)
ErrorDocument 404 /index.html
